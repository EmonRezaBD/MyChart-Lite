# Dependencies (Vite's client/.gitignore handles this inside client/)
   node_modules/

   # Build outputs
   dist/
   build/

   # Editor and OS junk
   .vscode/*
   !.vscode/settings.json
   .DS_Store
   Thumbs.db

   # Environment files (when we add them later)
   .env
   .env.local

   # Participant data — NEVER COMMIT
   data/
   *.csv
   participant_*

   # Logs
   *.log
   npm-debug.log*
   sync-page/